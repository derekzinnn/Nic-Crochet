# ─────────────────────────────────────────────────────────────
# Nic Crochet — environment variables
# Copy to `.env` and fill in. See SETUP.md for how to obtain each value.
# ─────────────────────────────────────────────────────────────

# ── Database (Supabase Postgres) ──
# Pooled connection (PgBouncer, port 6543) — used by the app at runtime.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — used by Prisma for migrations / db push.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Supabase Storage (product photos) ──
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
# Service-role key — SERVER ONLY, never expose to the client. Used for uploads.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
# Public bucket name for product photos.
SUPABASE_STORAGE_BUCKET="product-photos"

# ── Admin auth (single artisan account) ──
ADMIN_USERNAME="nic"
# bcrypt hash of the admin password. Generate with: npm run admin:hash -- "yourpassword"
# IMPORTANT: escape every `$` in the hash as `\$` (Next.js expands `$` otherwise).
# The admin:hash script prints a ready-to-paste, already-escaped line.
ADMIN_PASSWORD_HASH="\$2a\$10\$<escaped-bcrypt-hash>"
# Secret for signing the session cookie (JWT). Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="<long-random-string>"

# ── Public contact details (PLACEHOLDERS — swap before launch) ──
# WhatsApp number in international format, digits only (country + DDD + number).
NEXT_PUBLIC_WHATSAPP_NUMBER="5500000000000"
NEXT_PUBLIC_INSTAGRAM_HANDLE="nic.crochet"
NEXT_PUBLIC_CONTACT_EMAIL="contato@niccrochet.com"

# ── Site ──
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Shipping (ViaCEP is free/no-key; Melhor Envio needs an account) ──
# Origin CEP — where Nic ships from (Pelotas). Digits or 00000-000 both work.
SHIPPING_ORIGIN_CEP="96030-740"
# Melhor Envio API token. LEAVE EMPTY during early dev: with no token the app
# returns a clearly-labeled *simulated* freight estimate so checkout still works.
# Create a (free) sandbox app+token at https://sandbox.melhorenvio.com.br, paste
# it here to get real quotes, then switch BASE_URL + a production token at launch.
MELHOR_ENVIO_TOKEN=""
# Sandbox by default. Production: https://melhorenvio.com.br
MELHOR_ENVIO_BASE_URL="https://sandbox.melhorenvio.com.br"
# Melhor Envio requires a User-Agent carrying a contact email.
MELHOR_ENVIO_USER_AGENT="Nic Crochet (contato@niccrochet.com)"
