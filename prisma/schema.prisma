// Nic Crochet — data model
// Postgres (Supabase). Schema changes go through Prisma Migrate:
//   npm run db:migrate -- --name descricao   (create + apply a migration)
//   npm run db:deploy                         (apply pending migrations)
//   npm run db:status                         (check what's applied)
// The DB was baselined into prisma/migrations/0_init. Do NOT use `db push` on
// this project anymore — it bypasses the migration history.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductStatus {
  AVAILABLE // Disponível
  SOLD // Vendida (peça única já vendida)
  MADE_TO_ORDER // Sob encomenda
}

enum ProductKind {
  BAG // Bolsa
  CLOTHING // Roupa
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  kind        ProductKind   @default(BAG)
  category    String
  // Available sizes for clothing (e.g. ["P","M","G"]). Empty for bags.
  sizes       String[]      @default([])
  // Price stored in centavos to avoid floating-point money bugs.
  priceCents  Int
  description String        @default("")
  details     String[]      @default([])
  // Supabase Storage public URLs. First photo is the cover.
  photos      String[]      @default([])
  status      ProductStatus @default(AVAILABLE)
  tag         String? // optional badge, e.g. "Mais amada"
  featured    Boolean       @default(false)
  // Yarn colors this bag is available in — ids from the supplier palette
  // (src/lib/yarn-colors.ts). Also drive the woven placeholder swatch.
  colors      String[]      @default([])
  // Whether a customer ordering this bag may pick more than one color.
  allowsMultipleColors Boolean @default(false)
  // Delivery estimate in days (min/max). Null = not informed.
  leadTimeMinDays Int?
  leadTimeMaxDays Int?
  // Shipping package dimensions (Melhor Envio quote). Defaults suit a typical
  // crochet bag; Nic can adjust per piece in the admin wizard.
  weightGrams Int           @default(350)
  heightCm    Int           @default(12)
  widthCm     Int           @default(22)
  lengthCm    Int           @default(28)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([kind])
  @@index([category])
  @@index([status])
  @@index([featured])
}

enum CustomOrderStatus {
  NEW
  RESPONDED
  CLOSED
}

model CustomOrderRequest {
  id        String            @id @default(cuid())
  pieceType String // tipo de peça (Bolsa, Clutch...)
  size      String // tamanho (Pequena, Média, Grande)
  // Selected yarn color ids from the supplier palette (customer picks, not types).
  colors    String[]          @default([])
  deadline  String            @default("") // prazo desejado (texto livre)
  details   String            @default("")
  name      String
  contact   String // WhatsApp ou @instagram
  status    CustomOrderStatus @default(NEW)
  createdAt DateTime          @default(now())

  @@index([status])
  @@index([createdAt])
}

model Task {
  id        String    @id @default(cuid())
  title     String
  done      Boolean   @default(false)
  dueDate   DateTime? // optional deadline
  createdAt DateTime  @default(now())

  @@index([done])
  @@index([dueDate])
}

// A manual expense Nic logs (yarn, shipping labels, packaging...). Income is not
// stored here — it's read live from paid Orders — so the two never drift.
model Expense {
  id          String   @id @default(cuid())
  description String
  amountCents Int
  category    String   @default("Outros") // Fios, Aviamentos, Frete, Embalagem...
  date        DateTime // when the expense happened (Nic sets it)
  createdAt   DateTime @default(now())

  @@index([date])
}

// A sale made outside the site (Instagram, in person...) that Nic logs by hand,
// so the finance dashboard's income reflects everything, not just site orders.
model ManualSale {
  id          String   @id @default(cuid())
  description String // "Bolsa Amalfi — venda pelo Instagram"
  amountCents Int
  date        DateTime
  note        String? // optional (buyer, channel...)
  createdAt   DateTime @default(now())

  @@index([date])
}

// Single-row health record for the Melhor Envio quote call, so the admin panel
// can warn Nic that freight is failing (usually an expired token) instead of her
// finding out through a customer complaint.
model ShippingHealth {
  id                String    @id @default("singleton")
  lastSuccessAt     DateTime?
  lastFailureAt     DateTime?
  lastFailureReason String?
}

enum DeliveryMethod {
  SHIPPING // envio pelos Correios/transportadora
  PICKUP // retirada local no ateliê
}

// Payment states (PENDING/PAID/CANCELLED) come from Mercado Pago and are never
// set by hand. The fulfilment states after PAID are Nic's to advance.
enum OrderStatus {
  PENDING // criado, aguardando pagamento
  PAID // pagamento confirmado (Mercado Pago) — em produção
  READY // pronta: disponível para retirada, ou embalada para envio
  SHIPPED // postada (só envio) — com código de rastreio
  DELIVERED // entregue ou retirada — pedido concluído
  CANCELLED // cancelado / expirado / pagamento recusado
}

// A placed order. Items are stored as a JSON snapshot so the order stays
// immutable even if the product is later edited or deleted.
model Order {
  id            String         @id @default(cuid())
  // Unguessable token for the public "acompanhe seu pedido" link — set in code
  // from crypto random bytes (the cuid default only backfills existing rows).
  // The order id is never used for that link: ids appear in admin URLs.
  publicToken   String         @unique @default(cuid())
  items         Json // [{ productId, name, selectedColors[], selectedSize, qty, unitPriceCents }]
  subtotalCents Int

  deliveryMethod DeliveryMethod
  shippingCents  Int            @default(0)
  shippingLabel  String? // ex: "PAC (Correios)"
  shippingDays   Int?

  // Tracking code, filled by Nic once the parcel is posted (SHIPPING only).
  trackingCode String?

  // Shipping address (null for PICKUP)
  cep        String?
  street     String? // logradouro + número + complemento
  district   String? // bairro
  city       String?
  uf         String?

  // Customer contact
  customerName  String
  customerEmail String
  customerPhone String?

  totalCents Int
  status     OrderStatus @default(PENDING)

  // Mercado Pago references (filled once payment starts / confirms)
  mpPreferenceId String?
  mpPaymentId    String?

  // When the "pedido pago" e-mails went out — guards against duplicate sends
  // (webhook and the return page can both confirm the same payment).
  emailSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
